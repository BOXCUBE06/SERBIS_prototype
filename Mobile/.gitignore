# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Plugin registrants, rewritten by the tool on every `flutter pub get` and
# every build. They carry no reviewable content and churn on any machine that
# runs the app, so three of them showed as modified after every session.
# The desktop targets spell the directory lowercase, macOS capitalises it.
**/flutter/generated_plugin_registrant.cc
**/flutter/generated_plugin_registrant.h
**/flutter/generated_plugins.cmake
**/Flutter/GeneratedPluginRegistrant.swift

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Gradle build output for the Android host project. Regenerated on every
# build; `/build/` above only covers the Flutter root.
/android/build/

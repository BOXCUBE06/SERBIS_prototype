<?xml version="1.0" encoding="utf-8"?>
<!--
  Debug builds only. This file lives under src/debug/, so it is never merged
  into a profile or release APK — those keep the platform default, which is
  "no cleartext, ever".

  The local API is Laravel's `php artisan serve` over plain HTTP, which Android
  9+ blocks by default. Rather than switching cleartext back on globally, only
  the development hosts are exempted.

  Testing against a LAN address from a physical handset? Add your machine's IP
  as another <domain> below. Do not add a public hostname here — if it needs
  cleartext, it is not ready to be talked to.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <!-- The host machine, as seen from the Android emulator. -->
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>

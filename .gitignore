# Obsidian knowledge-base vault — lives inside the repo folder for the
# Local REST API / MCP path, but is not part of the codebase.
/obsidian-vault/

# Transfer-bundle leftovers (carry secrets: APP_KEY, PhilSMS key)
/backend-env/
/claude-global/
/README-TRANSFER.md

# Claude Code local machine state
/.claude/settings.local.json

# Agent tooling installed per-machine — not SERBIS code, and not the same
# from one checkout to the next.
/.claude/skills/
/.github/agents/
/.github/hooks/
/.github/skills/

# Screenshots and snapshots left behind by browser-driven checks.
/.playwright-mcp/

# Working cache the design-review tooling keeps between runs. PRODUCT.md, the
# one durable thing it writes, is tracked; this is not.
/.impeccable/

# Agent guidance for this repo. Local aid, not a deliverable -- kept out of
# what the panel reviews.
/CLAUDE.md

# Office lock files (e.g. docs-paper/~$Manuscript.docx while Word has it open).
~$*

# Manual screenshot capture: saved admin sign-in sessions (local tokens)
docs/user-manuals/tools/capture/.state/
# Manual screenshot capture: scratch images written by contact_sheet.py and the
# change check (samples/ holds the real upload fixtures and stays tracked).
docs/user-manuals/tools/capture/*.png

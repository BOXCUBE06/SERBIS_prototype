# Root of the Laravel API, including the /api prefix and no trailing slash.
#
# Vite bakes this into the bundle at build time, so it is a property of the
# build, not of the running server: a production build must be given this
# value by its build environment (Railway/Netlify/CI variables). There is no
# fallback — if it is unset, `npm run build` fails rather than emitting a
# bundle that points at a developer's laptop.
#
# `npm run dev` does not need a .env file; .env.development already carries the
# local value. Copy this file to .env only to point local dev somewhere else.
VITE_API_BASE=http://localhost:8000/api

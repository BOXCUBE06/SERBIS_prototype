<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- MySQL, not the sqlite default Laravel ships. Several migrations are
             MySQL-only (dropping a foreign key by name, for one), so the schema
             cannot be built on sqlite at all — and testing against a different
             engine than production would be the wrong trade even if it could.
             Create the database once: CREATE DATABASE serbis_phpunit; it is
             dropped and rebuilt by RefreshDatabase on every run. -->
        <env name="DB_CONNECTION" value="mysql"/>
        <env name="DB_DATABASE" value="serbis_phpunit"/>
        <env name="DB_HOST" value="127.0.0.1"/>
        <env name="DB_PORT" value="3306"/>
        <env name="DB_USERNAME" value="root"/>
        <env name="DB_PASSWORD" value=""/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <!-- A key so the OTP takes its real SMS path, and no waiting between
             sends so the reminder loops run at full speed. Every test that can
             reach a send fakes the host; SkySMS has no sandbox. -->
        <env name="SKYSMS_API_KEY" value="testing-key"/>
        <env name="SKYSMS_BASE_URL" value="https://skysms.skyio.site/api/v1"/>
        <env name="SKYSMS_PACE_SECONDS" value="0"/>
        <env name="SKYSMS_RETRY_BASE_SECONDS" value="0"/>
        <!-- Pinned false regardless of the developer's own .env (which may set
             this true for local E2E runs): most of this suite asserts against a
             real, Http::fake()'d send, and SERBIS_SMS_FAKE short-circuits
             SkySmsGateway before it ever reaches Http. SmsFakeTest is the only
             file that turns it on, and it does so per-test via config(). -->
        <env name="SERBIS_SMS_FAKE" value="false"/>
        <!-- Pinned empty regardless of the developer's own .env (which may set
             this for local Playwright runs): OtpBypassTest sets
             serbis.otp_bypass_code per-test via config(), the same way
             SmsFakeTest opts into SERBIS_SMS_FAKE above, so no test depends on
             this being set here. Pinning it stops an ambient .env value from
             quietly changing what "unset" means for every other test. -->
        <env name="SERBIS_OTP_BYPASS_CODE" value=""/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>

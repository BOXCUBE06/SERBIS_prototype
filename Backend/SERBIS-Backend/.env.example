APP_NAME=Laravel
APP_ENV=local
APP_KEY=
# Never commit a template that says true. Debug mode prints stack traces, file
# paths and SQL to any API caller, so a copied-and-unedited template leaks the
# whole application. Turn it on locally in your own .env, never here.
APP_DEBUG=false
# Placeholder on purpose. Set the real origin before deploying; locally this is
# http://localhost:8000. It feeds asset(), Storage::url() and signed URLs, so a
# wrong value produces links that resolve to the wrong host.
APP_URL=https://api.example.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# MySQL, not the sqlite Laravel ships. Several migrations are MySQL-only (they
# drop a foreign key by name), so the schema cannot be built on sqlite at all —
# phpunit.xml already forces mysql for the same reason. Left as sqlite, a copied
# template silently creates an empty file-backed database and every migration
# fails at a confusing place. Switch to pgsql only together with those
# migrations.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=serbis_db
DB_USERNAME=root
DB_PASSWORD=

# Path to the managed provider's CA certificate, for a host that requires TLS on
# the database connection (Aiven does). The name is Laravel's own stock key —
# config/database.php reads it inside an array_filter, so leaving it unset keeps
# a local plaintext connection working. Do not rename it to DB_SSL_CA.
#
# THAT array_filter IS ALSO THE TRAP. An unset — or misspelled, or wrongly
# pathed — value is filtered out, so PDO receives no ATTR_SSL_CA at all. The
# connection does not fail: MySQL still negotiates TLS, it just stops verifying
# who is on the other end, and the deployment looks entirely healthy. Nothing in
# the application will ever tell you. On a real host this must point at a
# readable file, and docker-entrypoint.sh refuses to boot the container when it
# does not.
#
# Aiven's CA is committed at storage/certs/aiven-ca.pem, which is
# /var/www/html/storage/certs/aiven-ca.pem inside the image — the value
# render.yaml sets. It is a public certificate, not a credential.
MYSQL_ATTR_SSL_CA=

# Password for the one admin account ProductionSeeder creates. Set it in the
# host's dashboard, never in a committed file; the seeder throws without it
# while no admin exists, and skips entirely once one does, so a redeploy cannot reset a
# password the admin has since changed.
ADMIN_SEED_PASSWORD=

# The shared 6-digit code that gates a text blast. Set it in the host's
# dashboard, never in a committed file; ProductionSmsBlastCodeSeeder skips
# without it, and skips entirely once a code row exists, so a redeploy cannot
# reset a code an admin has since rotated in the panel.
SMS_BLAST_CODE_SEED=

# Shared password and one mobile number each for the three barangay accounts
# ProductionSeeder creates (San Fabian, Pag-asa, San Antonio Ugad). Required
# only while an account is missing; the seeder throws without them then, and
# skips an account that already exists, so they can be unset after first boot.
BARANGAY_SEED_PASSWORD=
BARANGAY_SEED_PHONE_SAN_FABIAN=
BARANGAY_SEED_PHONE_PAG_ASA=
BARANGAY_SEED_PHONE_SAN_ANTONIO_UGAD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# SMS. Every text — the OTPs, the reminders and the admin text blast — goes
# through SkySMS (App\Services\Sms). A phone number is the resident login and
# the OTP goes only by text: there is no email fallback, so a send the vendor
# refuses is answered 503 sms_unavailable.
#
# SkySMS bills credits (1 credit = one 160-character message). A URL, domain or
# profanity in a message costs 10-50 credits and is not delivered, so those are
# refused before any request leaves. The account allows 30 messages a minute and
# 3 a second, shared by every key on it.
#
# NEVER select the 'ses' mailer: config/services.php reads AWS_ACCESS_KEY_ID and
# AWS_SECRET_ACCESS_KEY for it, the same two variables object storage uses above.
SKYSMS_API_KEY=
SKYSMS_BASE_URL=https://skysms.skyio.site/api/v1

# Admin two-step sign-in: username + password, then a code texted to the staff
# member's number (same code, expiry and resend rules as residents). Off by
# default. Every staff number — every super admin included — must be set first,
# in Staff Accounts or with `php artisan staff:set-phone <username> <number>`;
# `php artisan staff:usernames --missing` lists who is still without one. Each
# staff sign-in is then a billed SMS.
ADMIN_MFA_ENABLED=false

# Push notifications, FCM HTTP v1. Absolute path to a service-account JSON
# downloaded from Firebase Console -> Project Settings -> Service Accounts ->
# Generate new private key. Same class of secret as SKYSMS_API_KEY above —
# never commit the file this points at. The file carries the Firebase
# project id itself, so nothing else needs configuring here. The path is
# host-specific — Render's secret-file mount puts it under /etc/secrets/,
# something else may not.
FIREBASE_CREDENTIALS=/path/to/firebase-service-account.json
# Alternative to the path above, for a host with nowhere to put a bare secret
# file at all (Railway — see docs/deploy-railway.md). Base64 of the same JSON
# file. If set, docker-entrypoint.sh decodes it to a file on boot and points
# FIREBASE_CREDENTIALS at that file itself — set at most one of these two,
# never both. Leave unset for local dev.
FIREBASE_CREDENTIALS_BASE64=

# One R2 account, TWO buckets, because ID scans and info materials have
# opposite access rules. See config/filesystems.php for why they cannot share
# one. Both buckets use the credentials and endpoint below.
# Cloudflare dashboard -> R2 -> Manage R2 API Tokens. Scope the token to
# Object Read & Write on just these two buckets, not account-wide.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# R2 has no regions; 'auto' is the literal value the S3 API expects.
AWS_DEFAULT_REGION=auto
# R2's S3 API addresses buckets by path (https://<endpoint>/<bucket>/<key>),
# not by subdomain, so this stays true — same reason Supabase needed it.
AWS_USE_PATH_STYLE_ENDPOINT=true
# https://<account-id>.r2.cloudflarestorage.com — the account id is in the R2
# dashboard's API section, not the same id as any bucket.
AWS_ENDPOINT=

# PRIVATE bucket — government ID scans and resident photos. Never public: they
# are read only through the ownership-checked endpoints, which stream the bytes
# through the API. No AWS_URL, because nothing should ever build a direct link.
AWS_BUCKET=
AWS_URL=

# PUBLIC bucket — info materials, which residents read with no token. AWS_URL
# is required here: without it Storage::url() builds a link to the R2 API
# endpoint, which answers 401 in a browser. Either the bucket's r2.dev public
# development URL (Settings -> Public access -> enable, on this bucket only)
# or a custom domain connected to it — never enable public access on the
# private bucket.
AWS_PUBLIC_BUCKET=
AWS_PUBLIC_URL=

# Where uploads are written. Both default to the local disks, which is correct
# on this machine and WRONG on any host with an ephemeral filesystem: there,
# everything under storage/ disappears on the next deploy, including government
# ID scans that a resident cannot re-upload.
#
# In production these take DIFFERENT values — s3 and s3_public — because they
# are different buckets. Setting both to s3 puts ID scans in the public bucket.
#   UPLOADS_PRIVATE_DISK=s3
#   UPLOADS_PUBLIC_DISK=s3_public
# The alternative is a persistent volume mounted at storage/app, leaving both
# at their local defaults.
UPLOADS_PRIVATE_DISK=local
UPLOADS_PUBLIC_DISK=public

# Token lifetimes in minutes (audit #30). Admin defaults to a working day; the
# mobile app has no refresh flow, so residents get 30 days — short enough to
# bound a leaked token, long enough not to meet a login screen during a flood.
SANCTUM_ADMIN_EXPIRATION=480
SANCTUM_RESIDENT_EXPIRATION=43200

VITE_APP_NAME="${APP_NAME}"

ADMIN_FRONTEND_URL=http://localhost:3000

# Flutter web dev build. Only honoured when APP_ENV=local. Origins are matched
# string-exact: http://127.0.0.1:5000 is a different origin and will be refused.
MOBILE_DEV_URL=http://localhost:5000

# Test-only OTP bypass code for /resident/verify-email and
# /resident/login/verify, so a local client can finish sign-up and login
# without reading the SMS or email a real code goes to. Honoured only when
# APP_ENV=local; AppServiceProvider refuses to boot with this set anywhere else.
SERBIS_OTP_BYPASS_CODE=

# Test-only SMS suppression: when true, SkySmsGateway skips the real HTTP
# call and returns a synthetic success response instead, so an E2E run
# (Playwright, CI) never bills a real handset. Local/CI only — never set in
# production; AppServiceProvider refuses to boot if APP_ENV=production and
# this is set.
SERBIS_SMS_FAKE=

APP_NAME=Laravel
APP_ENV=testing
APP_KEY=base64:O0gDbLgS0PozSpXjrsfl3/uZAc5ESIpBDwRi0yKzTDI=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=4

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# A third, standalone database — never serbis_test_db (the live local dev
# database behind `php artisan serve`) and never serbis_phpunit (PHPUnit's
# own, dropped and rebuilt by RefreshDatabase on every run and actively in
# use whenever the suite is running). This is what makes `--env=testing`
# actually do what it looks like it does; without this file the flag was a
# silent no-op that fell back to plain .env (see docs/database-environments.md).
#
# Create the database once: CREATE DATABASE serbis_sandbox;
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=serbis_sandbox
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=array

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=array
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Deliberately unset here, unlike plain .env. A sandbox run that reaches a
# real send is a billed real SMS with no sandbox of its own (PhilSMS) — see
# phpunit.xml's own SERBIS_SMS_FAKE/PHILSMS_TOKEN comments for the same
# reasoning. Fill this in only for the one command invocation that needs it,
# never leave it populated here.
SKYSMS_API_KEY=

ADMIN_FRONTEND_URL=http://localhost:3000
MOBILE_DEV_URL=http://localhost:5000
